{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/api/verify-badge",
      "dest": "/api/verify-badge"
    },
    {
      "src": "/badge/(.*)",
      "dest": "/api/badge/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
