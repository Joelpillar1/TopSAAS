{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "trailingSlash": false,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "/accept(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/profile",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/payment-success",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/payment/success",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/badge/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/((?!assets/).*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/directories",
      "status": 308,
      "headers": {
        "Location": "/product-directory"
      }
    },
    {
      "src": "/directories/(.*)",
      "status": 308,
      "headers": {
        "Location": "/product-directory/$1"
      }
    },
    {
      "src": "/api/verify-badge",
      "dest": "/api/verify-badge"
    },
    {
      "src": "/api/autofill-submission",
      "dest": "/api/autofill-submission"
    },
    {
      "src": "/badge/(.*)",
      "dest": "/api/badge/$1"
    },
    {
      "src": "/r",
      "dest": "/api/r"
    },
    {
      "src": "/r/(.*)",
      "dest": "/api/r?slug=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/logo/(.*)",
      "status": 404
    },
    {
      "src": "/sitemap/(.*)",
      "status": 404
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/:file([^/]+\\.[^/]+)",
      "status": 404
    },
    {
      "src": "/repo/(.*)",
      "dest": "/repo/$1/index.html"
    },
    {
      "src": "/ideas",
      "dest": "/ideas/index.html"
    },
    {
      "src": "/product-directory",
      "dest": "/product-directory/index.html"
    },
    {
      "src": "/product-directory/(.*)",
      "dest": "/product-directory/$1/index.html"
    },
    {
      "src": "/products/(.*)",
      "dest": "/products/$1/index.html"
    },
    {
      "src": "/product/(.*)",
      "dest": "/product/$1/index.html"
    },
    {
      "src": "/trending",
      "dest": "/trending/index.html"
    },
    {
      "src": "/guides",
      "dest": "/guides/index.html"
    },
    {
      "src": "/guides/(.*)",
      "dest": "/guides/$1/index.html"
    },
    {
      "src": "/blog",
      "dest": "/blog/index.html"
    },
    {
      "src": "/blog/(.*)",
      "dest": "/blog/$1/index.html"
    },
    {
      "src": "/mrr-calculator",
      "dest": "/mrr-calculator/index.html"
    },
    {
      "src": "/submit",
      "dest": "/submit/index.html"
    },
    {
      "src": "/pricing",
      "dest": "/pricing/index.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy/index.html"
    },
    {
      "src": "/terms",
      "dest": "/terms/index.html"
    },
    {
      "src": "/profile",
      "dest": "/index.html"
    },
    {
      "src": "/payment-success",
      "dest": "/index.html"
    },
    {
      "src": "/payment/success",
      "dest": "/index.html"
    },
    {
      "src": "/accept",
      "dest": "/index.html"
    },
    {
      "src": "/accept/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
