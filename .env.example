# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Whop Configuration (Merchant of Record - https://whop.com)
# You can configure these in Supabase Edge Functions Secrets or in the whop_payments_config table:
# - WHOP_API_KEY: Your Whop API key from Dashboard > Developers (https://whop.com/dashboard/developer)
# - WHOP_WEBHOOK_SECRET: Webhook signing secret from Whop Dashboard > Webhooks
# - WHOP_COMPANY_ID: Your Whop Company / Business ID
# - WHOP_PLAN_1MO: Plan ID for 1-Month Sponsor ($29)
# - WHOP_PLAN_3MO: Plan ID for 3-Month Sponsor ($69)
# - WHOP_PLAN_1YR: Plan ID for 1-Year Partner Sponsor ($199)
# Direct checkout links (optional frontend fallbacks):
VITE_WHOP_LINK_1MO=https://whop.com/checkout/plan_your_1mo_plan_id
VITE_WHOP_LINK_3MO=https://whop.com/checkout/plan_your_3mo_plan_id
VITE_WHOP_LINK_1YR=https://whop.com/checkout/plan_your_1yr_plan_id

# Supabase Edge Function Secrets (set via `supabase secrets set`):
WHOP_API_KEY=whop_api_key_here
WHOP_WEBHOOK_SECRET=whop_webhook_secret_here
WHOP_PLAN_1MO=plan_your_1mo_plan_id
WHOP_PLAN_3MO=plan_your_3mo_plan_id
WHOP_PLAN_1YR=plan_your_1yr_plan_id
